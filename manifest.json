{
    "manifest_version": 3,
    "name": "Scratch Addon",
    "version": "1.0.0",
    "description":  "A scratch addon that enhances the scratch UI.",
    
    "content_scripts": [
        {
            "matches": ["https://scratch.mit.edu/"],
            "css": ["dashboard/style.css"],
            "js": ["dashboard/script.js"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://scratch.mit.edu/users/*"],
            "css": ["profile/style.css"],
            "js": ["profile/script.js"],
            "run_at": "document_start"
        }
    ],

    "web_accessible_resources": [
        {
            "resources": ["assets/*"],
            "matches": ["https://scratch.mit.edu/*"]
        }
    ]

}