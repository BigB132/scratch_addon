{
    "manifest_version": 3,
    "name": "Scratch Addon",
    "version": "1.0.0",
    "description":  "A scratch addon that enhances the scratch UI.",
    
    "content_scripts": [
        {
            "matches": ["https://scratch.mit.edu/"],
            "css": ["style.css"],
            "js": ["script.js"],
            "run_at": "document_start"
        }
    ],

    "web_accessible_resources": [
        {
        "resources": ["assets/heart.png", "assets/star.png", "assets/person.png", "assets/eye.png"],
        "matches": ["https://scratch.mit.edu/*"]
        }
    ]

}